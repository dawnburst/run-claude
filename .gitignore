# Artefacts produced by a `lmi schedule` run
run-claude-*.log
run-claude-state.md
run-claude.lock
*.bak

# Windows "downloaded from the internet" alternate data streams
*:Zone.Identifier

# Local Claude Code settings
.claude/

# Scratch space for a subagent-driven plan execution: ledger, task briefs,
# reports and review packages. Working notes, not history - once a plan is
# finished its directory is deleted and git log is the record.
.superpowers/

# Python build/test artefacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# The built wheel and pip's scratch directory. The wheel is a release asset,
# not a tracked file - it is reproducible from the source with one command
# (see "Building the wheel" in README.md).
build/
dist/

# Claude Code release binaries staged for an air-gapped transfer:
# tmp/claude-releases/<version>/<platform>/claude and its checksum. 1.4 GB for a
# single version, re-fetchable from the release channel, and a `git add -A` away
# from being committed - which is why it is named here rather than remembered.
tmp/
